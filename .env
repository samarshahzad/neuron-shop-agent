# ---------------------------------------------------------------------------
# Default configuration, committed to Git. NEVER put real secrets in this file.
#
# Put your real values (API key, MySQL password, ...) in .env.local instead.
# .env.local is git-ignored and overrides everything below.
#   cp .env.local.example .env.local
# ---------------------------------------------------------------------------

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_in_env_local
###< symfony/framework-bundle ###

###> AI provider (Neuron) ###
# Which model provider the agent uses: anthropic | openai | gemini | ollama
AI_PROVIDER=ollama

# Model name for the chosen provider, for example:
#   anthropic -> claude-sonnet-4-5      openai -> gpt-4.1-mini
#   gemini    -> gemini-2.5-flash       ollama -> qwen3
AI_MODEL=qwen3.6

# API key for anthropic / openai / gemini (not needed for ollama).
# Set the real key in .env.local, not here.
AI_API_KEY=

# Only used when AI_PROVIDER=ollama (free, runs on your own machine)
OLLAMA_URL=http://localhost:11434/api
###< AI provider (Neuron) ###

###> doctrine/doctrine-bundle ###
# Default: SQLite file, works without any setup.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# MySQL (start it with: docker compose up -d), then use this line in .env.local:
# DATABASE_URL="mysql://shop:shop@127.0.0.1:3306/shop_agent?serverVersion=8.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
