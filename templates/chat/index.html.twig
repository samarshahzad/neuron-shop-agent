<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kiez Living · Shop Assistant</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/chat.css">
</head>
<body>
<div class="app">
    <header class="topbar">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true">K</span>
            <div>
                <div class="brand-name">Kiez Living</div>
                <div class="brand-sub">Shop assistant · Symfony + Neuron AI</div>
            </div>
        </div>

        <nav class="tabs" aria-label="Views">
            <button type="button" class="tab is-active" data-view="assistant" aria-pressed="true">Assistant</button>
            <button type="button" class="tab" data-view="products" aria-pressed="false">Products</button>
        </nav>

        <div class="topbar-actions">
            <span class="model-badge" title="Configured in .env / .env.local">{{ model }}</span>
            <div class="account" id="account">
                <button type="button" class="btn-ghost" id="sign-in">Sign in</button>
            </div>
        </div>
    </header>

    {# ---------- Assistant view ---------- #}
    <main class="layout view" id="view-assistant">
        <section class="chat" aria-label="Chat">
            <div class="chat-head">
                <span class="chat-title">Chat</span>
                <button type="button" class="btn-link" id="new-chat">New chat</button>
            </div>
            <div class="messages" id="messages" aria-live="polite">
                <div class="welcome" id="welcome">
                    <h1>Hi! How can I help?</h1>
                    <p>I can check orders, search products and recommend things that go with what you bought. Ask in English or German.</p>
                    <div class="suggestions" id="suggestions">
                        <button type="button" class="chip">Where is my order SO-1002?</button>
                        <button type="button" class="chip">Wo ist meine Bestellung SO-1003?</button>
                        <button type="button" class="chip">What else would go with my order?</button>
                        <button type="button" class="chip">Which lamps are in stock?</button>
                        <button type="button" class="chip">Gifts under 30 €?</button>
                    </div>
                </div>
            </div>

            <form class="composer" id="composer" autocomplete="off">
                <label for="input" class="visually-hidden">Your message</label>
                <textarea id="input" rows="1" maxlength="2000" placeholder="Ask about an order or a product…" required></textarea>
                <button type="submit" class="btn-send" id="send" aria-label="Send">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 12l16-8-6 16-2.5-6.5L4 12z" fill="currentColor"/></svg>
                </button>
            </form>
        </section>

        <aside class="panel" aria-label="Your account" id="side-panel">
            {# Filled by chat.js: signed-out view (all orders) or signed-in view (your orders + recommendations) #}
            <p class="orders-empty">Loading…</p>
        </aside>
    </main>

    {# ---------- Products view ---------- #}
    <main class="products-view view" id="view-products" hidden>
        <div class="products-head">
            <div>
                <h1 class="products-title">Products</h1>
                <p class="panel-hint" id="similarity-hint"></p>
            </div>
            <div class="filters" id="filters" role="group" aria-label="Filter by category"></div>
        </div>
        <div class="product-grid" id="product-grid"></div>
    </main>
</div>

{# ---------- Sign-in dialog ---------- #}
<dialog class="dialog" id="sign-in-dialog" aria-labelledby="sign-in-title">
    <form method="dialog" class="dialog-close-row">
        <h2 id="sign-in-title">Sign in</h2>
        <button class="btn-link" value="cancel" aria-label="Close">Close</button>
    </form>

    <h3 class="dialog-sub">Demo customers</h3>
    <p class="panel-hint">Pick a customer to see their orders and recommendations.</p>
    <ul class="customer-list" id="customer-list"></ul>

    <div class="divider"><span>or</span></div>

    <h3 class="dialog-sub">Email + order number</h3>
    <form class="order-login" id="order-login" novalidate>
        <label>Email
            <input type="email" name="email" autocomplete="email" placeholder="lena.fischer@example.com" required maxlength="180">
        </label>
        <label>Order number
            <input type="text" name="orderNumber" placeholder="SO-1001" required maxlength="20">
        </label>
        <p class="form-error" id="login-error" role="alert" hidden></p>
        <button type="submit" class="btn-primary">Sign in</button>
    </form>
</dialog>

{# ---------- Similar products dialog ---------- #}
<dialog class="dialog dialog-wide" id="similar-dialog" aria-labelledby="similar-title">
    <form method="dialog" class="dialog-close-row">
        <h2 id="similar-title">Similar products</h2>
        <button class="btn-link" value="cancel" aria-label="Close">Close</button>
    </form>
    <p class="panel-hint" id="similar-sub"></p>
    <div class="rec-list" id="similar-list"></div>
</dialog>

<script src="/js/chat.js"></script>
</body>
</html>
