# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored, so your secrets never end up on GitHub.

APP_SECRET=put-a-long-random-string-here

# --- Option A: Anthropic (Claude) ---
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-5
# AI_API_KEY=sk-ant-...

# --- Option B: OpenAI ---
# AI_PROVIDER=openai
# AI_MODEL=gpt-4.1-mini
# AI_API_KEY=sk-...

# --- Option C: Ollama, free and local (default) ---
# AI_PROVIDER=ollama
# AI_MODEL=qwen3
# OLLAMA_URL=http://localhost:11434/api

# --- MySQL via Docker instead of SQLite ---
# DATABASE_URL="mysql://shop:shop@127.0.0.1:3306/shop_agent?serverVersion=8.4&charset=utf8mb4"
